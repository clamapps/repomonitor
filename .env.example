# Public URL registered as the callback base for both OAuth providers.
APP_URL=http://localhost:3000

# Create with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters
# Create with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

DATABASE_URL=file:./data/repomonitor.db

# GitHub OAuth App (callback: ${APP_URL}/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# In production, the separate GitHub App for public polling is registered and
# authorized by a super-admin from Settings. Development uses anonymous public
# REST polling because GitHub rejects localhost webhook URLs in app manifests.

# Case-insensitive, comma-separated GitHub logins.
SUPER_ADMIN_GITHUB_LOGINS=

# Daily polling schedule and notification pacing.
POLL_CRON=17 3 * * *
POLL_TIMEZONE=UTC
EMAIL_DELAY_MIN_MS=2000
EMAIL_DELAY_MAX_MS=10000
SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_FROM=RepoMonitor <repomonitor@localhost>

# Google OAuth web app (callback: ${APP_URL}/api/admin/gmail/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated additional client IDs accepted by the RISC receiver.
GOOGLE_RISC_CLIENT_IDS=
